{
  "name": "portal-neoguard-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Portal Neoguard — Fase 1: Ficha de Implantação (React + Vite + Ant Design)",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc --noEmit && vite build",
